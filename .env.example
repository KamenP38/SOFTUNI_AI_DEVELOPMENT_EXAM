# Reference only: Django does not automatically load this file.
# Set these as PowerShell environment variables as shown in README.md.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SHOP_NAME=Alan Barberhouse
SHOW_DEMO_NOTICE=1
DATABASE_BACKEND=sqlite

# Generate a unique DJANGO_SECRET_KEY; do not commit the actual value.
# DJANGO_SECRET_KEY=

# For a separately created local PostgreSQL database:
# DATABASE_BACKEND=postgresql
# POSTGRES_DB=barber_shop
# POSTGRES_USER=barber_shop
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
